# All relative paths resolve against CRICSTAT_HOME (default: the cricstat/ folder; /cricstat in the image).
CRICSTAT_SERVING_DB=data/db/cricstat.sqlite
CRICSTAT_RAW_DB=data/db/raw.sqlite
CRICSTAT_LOG_LEVEL=INFO
CRICSTAT_API_CACHE_MAX_AGE=300
CRICSTAT_API_CACHE_SWR=3600
CRICSTAT_API_QUERY_SECONDS=10
