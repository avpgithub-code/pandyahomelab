# Build context for cricstat images is cricstat/ (F6 §1). Data, logs, docs and caches never go in
# (one exception: the golden selection, which cricstat-api serves to the admin page).
data/
logs/
docs/*
!docs/validation
docs/validation/*
!docs/validation/golden-selection.csv
web/
.git
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/*.pyc
**/.venv/
**/tests/
**/*.md
**/*.sqlite*
**/*.zip
**/.env
**/.env.*
!**/.env.example
