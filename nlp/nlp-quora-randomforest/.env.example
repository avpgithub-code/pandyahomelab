# API Configuration
DEBUG=false
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# MLflow Tracking — the only NLP domain service (Phase 3 gate G1)
MLFLOW_TRACKING_URI=http://nlp-mlflow:5000
MLFLOW_PUBLIC_BASE_URL=https://mlflow-nlp.pandyahomelab.com

# GLUE QQP parquet files (make data); mounted into the container, never baked in
QQP_DATA_DIR=/app/data/qqp
QQP_MAX_TRAIN_ROWS=100000
QQP_MAX_TEST_ROWS=0
