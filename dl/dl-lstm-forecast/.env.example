# API Configuration
DEBUG=false
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@dl-postgres:5432/dldb

# Object Storage (MinIO)
MINIO_ENDPOINT=dl-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET is not set: the DL services do not use a MinIO bucket
# (dl-mlflow stores artifacts on its own volume, not in dl-minio).

# Cache (Redis)
REDIS_URL=redis://dl-redis:6379

# MLflow Tracking
MLFLOW_TRACKING_URI=http://dl-mlflow:5000
