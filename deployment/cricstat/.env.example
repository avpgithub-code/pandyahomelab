# cricstat stack environment — copy to .env (gitignored) and `chmod 600 .env` (ADR-010).
# Every variable the stack reads is listed here. Values below are placeholders/defaults.

# Container user = operator UID/GID (ADR-009)
HOST_UID=1026
HOST_GID=100

# cricstat-pipeline (defaults shown; see cricstat/cricstat-pipeline/.env.example for the full list)
# CRICSTAT_RAW_DB=data/db/raw.sqlite
# CRICSTAT_KEEP_FULL_ZIPS=3

# cricstat-agent (P4) — secrets: never commit real values
# ANTHROPIC_API_KEY=sk-ant-...
# CRICSTAT_AGENT_DAILY_BUDGET_USD=2.00        # hard daily cap enforced in-app
# CRICSTAT_AGENT_QUESTIONS_PER_IP_PER_DAY=20
# CRICSTAT_AGENT_RETENTION_DAYS=30
# CRICSTAT_AGENT_ENABLED=true                 # kill switch
